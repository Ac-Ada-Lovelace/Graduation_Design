<Window x:Class="GraduationDesign.App.Views.DeviceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终端详情"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#FF173042" Text="{Binding DisplayName}" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#FF587282" Text="{Binding DeviceCodeText}" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding LastReceivedTimeText}" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding LastReportTimeText}" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding RemoteEndPoint}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                        <TextBlock FontSize="12" Foreground="White" Text="{Binding StatusText}" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding LatestCurrentText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding LatestVoltageText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding LatestPowerText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#FF587282" Text="{Binding PacketCount, StringFormat=累计报文: {0:N0}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <TabControl Margin="0,6,0,0"
                            Style="{StaticResource SafeTabControlStyle}"
                            ItemContainerStyle="{StaticResource SafeTabItemStyle}">
                    <TabItem Header="实时趋势">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FF173042" Text="A 相功率实时趋势" />
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FF587282" Text="显示最近 30 个采样点的实时变化" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock FontSize="12" Foreground="#FF587282" Text="当前值" HorizontalAlignment="Right" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding LatestPowerAText}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Margin="0,16,0,0"
                                    Background="#FFF4F9FB"
                                    BorderBrush="#FFD7E9EF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Viewbox Stretch="Uniform">
                                        <Canvas Width="760" Height="220">
                                            <Rectangle Width="760" Height="220" RadiusX="8" RadiusY="8" Fill="#FFF8FCFD" />
                                            <Polyline Points="{Binding DetailPowerTrendPoints}"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,12,0,0"
                                               FontSize="12"
                                               Foreground="#FF587282"
                                               HorizontalAlignment="Right"
                                               Text="{Binding TrendRangeText}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="报文列表">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FF173042" Text="终端报文列表" />
                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FF587282" Text="点击“查看详情”进入协议包详情页" />
                            </StackPanel>

                            <DataGrid x:Name="PacketsGrid"
                                      Grid.Row="1"
                                      Margin="0,16,0,0"
                                      Style="{StaticResource SoftDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource SoftDataGridHeaderStyle}"
                                      CellStyle="{StaticResource SoftDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      RowHeight="32"
                                      ItemsSource="{Binding RecentPackets}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="160" Header="接收时间" Binding="{Binding ReceivedAtText}" />
                                    <DataGridTextColumn Width="160" Header="上报时间" Binding="{Binding ReportTimeText}" />
                                    <DataGridTextColumn Width="120" Header="解析状态" Binding="{Binding ParseStatusText}" />
                                    <DataGridTextColumn Width="*" Header="摘要" Binding="{Binding SummaryText}" />
                                    <DataGridTemplateColumn Width="96" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource InlineActionButtonStyle}"
                                                        Click="OpenPacketDetail_Click"
                                                        Tag="{Binding}"
                                                        Content="查看详情" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FF173042" Text="状态事件" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FF587282" Text="记录上线、离线、异常和连接变化" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="0,16,0,0"
                             Style="{StaticResource SoftListBoxStyle}"
                             ItemsSource="{Binding Events}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" Background="#FFF6FAFC" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#FF587282" Text="{Binding TimestampText}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FF173042" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
